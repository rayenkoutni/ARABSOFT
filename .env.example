# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/portail_rh?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="portail_rh"

# Authentication
JWT_SECRET="generate_a_long_random_string_here"

# Messaging
